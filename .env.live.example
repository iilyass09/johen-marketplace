# =====================================================================
# CONTOH KONFIGURASI LIVE (salin nilai yang sesuai lalu simpan sebagai .env)
# JANGAN commit file ini berisi secret asli. Ini hanya template.
# Ganti semua nilai <DARI_DASHBOARD_...> dengan milikmu.
# =====================================================================

# --- Aplikasi ---
APP_NAME=Johen Marketplace
APP_ENV=production
APP_DEBUG=false
# WAJIB: domain publik + HTTPS agar webhook Xendit & Digiflazz dapat diakses
APP_URL=https://domain-anda.com

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=johen_marketplace
DB_USERNAME=root
DB_PASSWORD=

# --- Digiflazz (pemasok top-up) ---
# Username & key dari panel digiflazz.com > Pengaturan Koneksi
DIGIFLAZZ_USERNAME=<DARI_DASHBOARD_DIGIFLAZZ>
# LIVE: gunakan key PRODUKSI (bukan dev-). Pastikan cocok dengan mode.
DIGIFLAZZ_KEY=<KEY_DIGIFLAZZ_PRODUKSI>
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_PRODUCTION=true

# --- Xendit (payment gateway) ---
# LIVE: secret key PRODUKSI (prefiks xnd_production_) dari Xendit Dashboard > Settings > API Keys
XENDIT_SECRET_KEY=<KEY_XENDIT_PRODUKSI>
# Callback Token yang SAMA dengan yang diset di Dashboard Xendit > Settings > Callbacks
XENDIT_CALLBACK_TOKEN=<CALLBACK_TOKEN_XENDIT>
XENDIT_IS_PRODUCTION=true

# --- Simulasi pembayaran ---
# true  = tanpa charge nyata (uji aman). false = pembayaran nyata.
PAYMENT_SIMULATION=false

# --- Saluran pembayaran ---
# qris    = QRIS ditampilkan & dibayar langsung di halaman sendiri
# invoice = pelanggan diarahkan ke halaman invoice Xendit
PAYMENT_CHANNEL=qris
